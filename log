Python例子：

import json
import re


patterns = [
    (
        r"sk-[A-Za-z0-9]+",
        "[OPENAI_KEY]"
    ),
    (
        r"password\s*=\s*\S+",
        "password=[REDACTED]"
    ),
    (
        r"Bearer\s+\S+",
        "Bearer [TOKEN]"
    )
]


def redact(text):

    for p,r in patterns:
        text=re.sub(p,r,text)

    return text


with open("session.jsonl") as f, \
     open("safe-session.jsonl","w") as out:

    for line in f:
        data=json.loads(line)

        if "content" in data:
            data["content"]=redact(
                data["content"]
            )

        out.write(
            json.dumps(data)+"\n"
        )
