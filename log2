5. 脱敏 Filter

创建：

/etc/fluent-bit/redact.lua

内容：

function redact(tag, timestamp, record)


    local msg = record["content"]

    if msg == nil then
        return 1,timestamp,record
    end


    -- OpenAI key
    msg = string.gsub(
        msg,
        "sk%-[%w]+",
        "[OPENAI_KEY]"
    )


    -- Github token
    msg = string.gsub(
        msg,
        "ghp_[%w]+",
        "[GITHUB_TOKEN]"
    )


    -- Bearer token
    msg = string.gsub(
        msg,
        "Bearer%s+[%w%.%-_]+",
        "Bearer [TOKEN]"
    )


    -- password
    msg = string.gsub(
        msg,
        "password=[^ ]+",
        "password=[REDACTED]"
    )


    -- private key

    msg = string.gsub(
        msg,
        "-----BEGIN PRIVATE KEY-----.+-----END PRIVATE KEY-----",
        "[PRIVATE_KEY]"
    )


    record["content"]=msg


    return 1,timestamp,record

end
6. Fluent Bit Filter

配置：

[FILTER]
    Name lua

    Match *

    script /etc/fluent-bit/redact.lua

    call redact

现在：

输入：

{
"type":"user_message",
"content":
"export OPENAI_KEY=sk-abcd1234"
}

输出：

{
"type":"user_message",
"content":
"export OPENAI_KEY=[OPENAI_KEY]"
}
